# BSharp behavior smoke test
# Run with: .\cmake-build-debug\BSharp.exe .\tests\behavior_smoke.bs

print("== BSharp smoke test ==")

assert(1 + 2 * 3 == 7)
assert(2 ^ 3 ^ 2 == 512)
assert(5! == 120)
assert(1 < 2 < 3)
assert(not (1 < 2 > 3))
assert(true and not false)
assert(true xor false)

s = "Hi"
assert(s + "!" == "Hi!")
assert(s * 3 == "HiHiHi")
assert(s[0] == "H")
assert(s[-1] == "i")

xs = [1, 2, 3]
assert(xs[0] == 1)
assert(xs[-1] == 3)
xs[1] += 40
assert(xs[1] == 42)

fn add(a, b) = a + b
assert(add(20, 22) == 42)

fn fib(n) do
    if n <= 1 do
        return n
    return fib(n - 1) + fib(n - 2)

assert(fib(8) == 21)

total = 0
for i = 0 ~ 5 do
    total += i
assert(total == 10)

down = 0
for j = 5 ~ 0 do
    down += j
assert(down == 15)

k = 0
while k < 10 do
    k += 1
    if k == 3 do
        continue
    if k == 6 do
        break
assert(k == 6)

u = 0
until u == 3 do
    u += 1
assert(u == 3)

outer = 1
if true do
    outer = 99
assert(outer == 99)

print("all smoke assertions passed")
