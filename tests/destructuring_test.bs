# =========================================================================
# B# Milestone 3 - 解構賦值與隱式序列功能測試腳本
# =========================================================================

# -------------------------------------------------------------------------
# 【測試 1】基礎功能與變數交換
# -------------------------------------------------------------------------
a, b, c = [10, 20, 30]
assert(a == 10)
assert(b == 20)
assert(c == 30)

# 經典變數交換：驗證右式是否有先完整求值
x = "X"
y = "Y"
x, y = [y, x]
assert(x == "Y")
assert(y == "X")


# -------------------------------------------------------------------------
# 【測試 2】優先級與常態列表二義性驗證（修復先前的 Bug）
# -------------------------------------------------------------------------
# 驗證 [1, 2, 3] 內部的逗號不會被錯誤抓去解構，而是留給 list
my_list = [1, 2, 3]
assert(my_list[0] == 1)
assert(my_list[1] == 2)
assert(my_list[2] == 3)

# 複雜嵌套解構：左式與右式同時包含常態 list
list_a, list_b = [[1, 2], [3, 4]]
assert(list_a[0] == 1)
assert(list_a[1] == 2)
assert(list_b[0] == 3)
assert(list_b[1] == 4)


# -------------------------------------------------------------------------
# 【測試 3】支援 Trailing Comma（尾隨逗號）特例測試
# -------------------------------------------------------------------------
# 驗證左側變數清單帶有尾隨逗號
name, age, = ["bibibird", 18]
assert(name == "bibibird")
assert(age == 18)

# 驗證右側列表帶有尾隨逗號（對齊原本 list 的範式）
u, v = [100, 200,]
assert(u == 100)
assert(v == 200)


# -------------------------------------------------------------------------
# 【測試 4】下標賦值（Subscript Assign）未被新架構破壞
# -------------------------------------------------------------------------
items = [5, 6, 7]
items[1] = 99
assert(items[0] == 5)
assert(items[1] == 99)
assert(items[2] == 7)


print("all the test passed")