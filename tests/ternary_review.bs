assert(if true do 1 else 2 == 1)
assert(if false do 1 else 2 == 2)

a = if true do 10 else 20
b = if false do 10 else 20
assert(a == 10)
assert(b == 20)

assert((if true do 10 else 20) + 5 == 15)
assert((if false do 10 else 20) + 5 == 25)

nested_left = if true do if false do 1 else 2 else 3
nested_right = if false do 1 else if true do 2 else 3
assert(nested_left == 2)
assert(nested_right == 2)

print("ternary review passed")
