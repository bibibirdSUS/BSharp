# unpack_test.bs

# ----------------------------------------

# Basic unpack

# ----------------------------------------

fn count(args...) = len(args)

assert(count(*[1, 2, 3]) == 3)
assert(count(*[]) == 0)

# ----------------------------------------

# Mixed arguments

# ----------------------------------------

assert(count(0, *[1, 2, 3], 4) == 5)

# ----------------------------------------

# Multiple unpack

# ----------------------------------------

assert(count(*[1, 2], *[3, 4], *[5]) == 5)

# ----------------------------------------

# Variadic receives correct values

# ----------------------------------------

fn sum(args...) do
    total = 0


    for x in args do
        total += x

    return total


assert(sum(*[1, 2, 3]) == 6)
assert(sum(10, *[1, 2, 3]) == 16)
assert(sum(*[1, 2], *[3, 4]) == 10)

# ----------------------------------------

# Nested call

# ----------------------------------------

fn values() = [1, 2, 3]

assert(sum(*values()) == 6)

# ----------------------------------------

# Destructuring + unpack

# ----------------------------------------

a, b, c = [10, 20, 30]

assert(sum(*[a, b, c]) == 60)

# ----------------------------------------

# Empty iterable

# ----------------------------------------

assert(count(*[]) == 0)
assert(sum(*[]) == 0)

# ----------------------------------------

# Call forwarding

# ----------------------------------------

fn forward(args...) do
    return sum(*args)


assert(forward(1, 2, 3) == 6)
assert(forward(5, 5, 5) == 15)

# ----------------------------------------

# Complex composition

# ----------------------------------------

fn make() = [1, 2]

assert(count(0, *make(), 3, *[4, 5]) == 6)

print("all unpack tests passed")
