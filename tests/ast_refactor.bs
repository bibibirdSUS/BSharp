print("=== AST Refactor Tests ===")
# ----------------------------------
# assign_node (variable)
# ----------------------------------

a = 10
assert(a == 10)

a += 5
assert(a == 15)

a -= 3
assert(a == 12)

a *= 2
assert(a == 24)

a /= 6
assert(a == 4)

a %= 3
assert(a == 1)

a ^= 5
assert(a == 1)

# ----------------------------------
# assign_node (subscript)
# ----------------------------------

list = [1, 2, 3]

list[0] = 10
assert(list[0] == 10)

list[1] += 5
assert(list[1] == 7)

list[2] *= 2
assert(list[2] == 6)

# ----------------------------------
# destructuring assignment
# ----------------------------------

a, b, c = [10, 20, 30]

assert(a == 10)
assert(b == 20)
assert(c == 30)

# ----------------------------------
# nested assignable targets
# ----------------------------------

arr = [[1, 2], [3, 4]]

arr[0][1] = 99

assert(arr[0][0] == 1)
assert(arr[0][1] == 99)

# ----------------------------------
# expr_list still behaves correctly
# ----------------------------------

x = (1, 2, 3)

assert(x[0] == 1)
assert(x[1] == 2)
assert(x[2] == 3)

# ----------------------------------
# function parameters
# ----------------------------------

fn add(a, b) = a + b

assert(add(3, 4) == 7)

fn identity(x) do
    return x

assert(identity(123) == 123)

# ----------------------------------
# parameter ordering
# ----------------------------------

fn combine(a, b, c) do
    return a * 100 + b * 10 + c

assert(combine(1, 2, 3) == 123)

# ----------------------------------
# range-for regression
# ----------------------------------

sum = 0

for i = 1 ~ 5 do
    sum += i

assert(sum == 10)

# ----------------------------------
# range-for with step
# ----------------------------------

sum = 0

for i = 0 ~ 10 : 2 do
    sum += i

assert(sum == 20)

# ----------------------------------
# destructuring + assignment helper
# ----------------------------------

a, b = [1, 2]

a += 10
b *= 5

assert(a == 11)
assert(b == 10)

# ----------------------------------
# subscript assignment after destructuring
# ----------------------------------

arr = [0, 0]

idx = 1

arr[idx] = 42

assert(arr[1] == 42)

print("All AST refactor tests passed!")
