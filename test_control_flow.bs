

print("Starting Control Flow Tests...")


fn add(a, b) do
    return a + b
    print("This should not be printed")

assert(add(5, 10) == 15)
print("Test 1: Basic return passed")


fn find_even(start, end) do
    for i = start ~ end do
        if i % 2 == 0 do
            return i
    return null

assert(find_even(1, 5) == 2)
assert(find_even(7, 8) == null)
print("Test 2: Nested return passed")


x = 0
while x < 10 do
    x += 1
    if x == 5 do
        break
assert(x == 5)
print("Test 3: while break passed")


x = 0
sum = 0
while x < 5 do
    x += 1
    if x == 3 do
        continue
    sum += x

assert(sum == 12)
print("Test 4: while continue passed")


found_i = 0
for i = 1 ~ 10 do
    if i == 6 do
        break
    found_i = i
assert(found_i == 5)
print("Test 5: for break passed")


sum_for = 0
for i = 1 ~ 5 do
    if i == 3 do
        continue
    sum_for += i

assert(sum_for == 7)
print("Test 6: for continue passed")


outer_count = 0
inner_total = 0
for i = 1 ~ 4 do
    outer_count += 1
    for j = 1 ~ 10 do
        if j == 3 do
            break
        inner_total += 1

assert(outer_count == 3)
assert(inner_total == 6)
print("Test 7: Nested loops break passed")

print("All Control Flow Tests Passed Successfully!")
