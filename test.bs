print("--- Test 1: Simple Return ---")
fn add(a, b) do
    return a + b
    print("This should never be printed!")

assert(add(5, 7) == 12)
assert(add(1, 1) != 3)


print("--- Test 2: Early Return with Condition ---")
fn absolute_value(x) do
    if x < 0 do
        return -x
    return x

assert(absolute_value(-10) == 10)
assert(absolute_value(5) == 5)
assert(absolute_value(0) == 0)


print("--- Test 3: Loop Break and Scope ---")
break_counter = 0
for i = 1 ~ 10 do
    if i == 5 do
        break
    break_counter += 1

assert(break_counter == 4)


print("--- Test 4: Loop Continue ---")
sum_even = 0
for i = 1 ~ 6 do
    if i % 2 != 0 do
        continue
    sum_even += i

assert(sum_even == 6)


print("--- Test 5: Nested Loop Flow Control ---")
outer_count = 0
inner_count = 0

for x = 1 ~ 4 do
    outer_count += 1
    for y = 1 ~ 4 do
        if y == 2 do
            continue
        if x == 3 do
            break
        inner_count += 1

assert(outer_count == 3)
assert(inner_count == 4)


print("--- Test 6: Deep Closure with Return ---")
fn make_fib_verifier() do
    fn verify(n) do
        if n <= 1 do
            return n
        return verify(n - 1) + verify(n - 2)
    return verify

fib = make_fib_verifier()
assert(fib(5) == 5)
assert(fib(6) == 8)

print("All tests passed successfully!")